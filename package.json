{
  "name": "recovery-probe",
  "version": "0.6.0-preview.9",
  "type": "module",
  "description": "Test whether web and Electron desktop apps show the right data when a read fails, from the command line, your tests or an AI coding agent.",
  "license": "MIT",
  "author": "Bojan Kovachki",
  "homepage": "https://github.com/BojanKovachki/recovery-probe#readme",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./fetch": {
      "types": "./dist/fetch-fault.d.mts",
      "import": "./dist/fetch-fault.mjs",
      "default": "./dist/fetch-fault.mjs"
    },
    "./net": {
      "types": "./dist/net-fault.d.mts",
      "import": "./dist/net-fault.mjs",
      "default": "./dist/net-fault.mjs"
    },
    "./desktop": {
      "types": "./dist/desktop.d.mts",
      "import": "./dist/desktop.mjs",
      "default": "./dist/desktop.mjs"
    },
    "./web": {
      "types": "./dist/web.d.mts",
      "import": "./dist/web.mjs",
      "default": "./dist/web.mjs"
    },
    "./ipc-inspector": {
      "types": "./dist/ipc-inspector.d.mts",
      "import": "./dist/ipc-inspector.mjs"
    },
    "./ipc": {
      "types": "./dist/ipc-probe.d.cts",
      "import": "./dist/ipc-probe.cjs",
      "require": "./dist/ipc-probe.cjs"
    }
  },
  "bin": {
    "recovery-probe": "bin/recovery-probe.mjs"
  },
  "files": [
    "dist",
    "bin",
    "examples",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "playwright": "^1.62.1",
    "typescript": ">=4.7"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BojanKovachki/recovery-probe.git"
  },
  "bugs": {
    "url": "https://github.com/BojanKovachki/recovery-probe/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "keywords": [
    "playwright",
    "testing",
    "resilience",
    "recovery",
    "fault-injection",
    "e2e",
    "retry",
    "fetch",
    "electron",
    "ipc",
    "refresh",
    "observation",
    "ui-state",
    "cache",
    "mcp",
    "ai-agents",
    "network-faults",
    "static-analysis"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run build --silent && tsc -p .",
    "test": "npm run test:unit",
    "test:unit": "npm run build --silent && node --test \"test/unit/*.test.mjs\"",
    "test:integration": "npm run build --silent && node --test \"test/integration/*.test.mjs\"",
    "test:electron": "npm run build --silent && node --test --test-concurrency=1 \"test/electron/*.test.mjs\"",
    "test:package": "npm run build --silent && node --test \"test/package/*.test.mjs\"",
    "test:repair": "npm run build --silent && node --test test/unit/repair.test.mjs test/integration/repair.test.mjs test/integration/web.test.mjs",
    "test:ci-example": "npm run build --silent && node examples/ci/verify.mjs",
    "test:all": "npm run test:unit && npm run test:package && npm run test:integration && npm run test:ci-example",
    "prepublishOnly": "npm run test:unit && npm run test:package",
    "demo": "npm run build --silent && node dist/cli/core-demo.mjs",
    "demo:browser": "npm run build --silent && node bin/recovery-probe.mjs --demo --out artifacts/browser-demo.json",
    "benchmark:observe": "npm run build --silent && node scripts/benchmark-observe.mjs"
  }
}
