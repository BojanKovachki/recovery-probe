{
  "name": "recovery-probe",
  "version": "0.4.0",
  "type": "module",
  "description": "Test whether web and Electron desktop apps show the right data.",
  "license": "MIT",
  "author": "Bojan Kovachki",
  "homepage": "https://github.com/BojanKovachki/recovery-probe#readme",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./fetch": {
      "types": "./src/fetch-fault.d.mts",
      "import": "./src/fetch-fault.mjs",
      "default": "./src/fetch-fault.mjs"
    },
    "./desktop": {
      "types": "./src/desktop.d.mts",
      "import": "./src/desktop.mjs",
      "default": "./src/desktop.mjs"
    },
    "./web": {
      "types": "./src/web.d.mts",
      "import": "./src/web.mjs",
      "default": "./src/web.mjs"
    },
    "./ipc-inspector": {
      "types": "./src/ipc-inspector.d.mts",
      "import": "./src/ipc-inspector.mjs"
    },
    "./ipc": {
      "types": "./src/ipc-probe.d.cts",
      "import": "./src/ipc-probe.cjs",
      "require": "./src/ipc-probe.cjs"
    }
  },
  "bin": {
    "recovery-probe": "bin/recovery-probe.mjs"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "docs/demo.svg",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README.md",
    "LICENSE",
    "docs/desktop.md",
    "docs/repair.md",
    "docs/start.md",
    "docs/ipc.md",
    "docs/refresh.md",
    "docs/observe.md",
    "docs/ci.md",
    "docs/api.md",
    "docs/runner.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "playwright": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BojanKovachki/recovery-probe.git"
  },
  "bugs": {
    "url": "https://github.com/BojanKovachki/recovery-probe/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "playwright",
    "testing",
    "resilience",
    "recovery",
    "fault-injection",
    "e2e",
    "retry",
    "fetch",
    "electron",
    "ipc",
    "refresh",
    "observation",
    "ui-state",
    "cache"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "npm run test:core",
    "test:core": "node --test test/fetch-core.test.mjs",
    "test:browser": "node --test test/recovery.integration.test.mjs test/discovery.integration.test.mjs test/discovery-calibration.integration.test.mjs test/attach.integration.test.mjs test/refresh.integration.test.mjs test/observe.integration.test.mjs test/observe-queue.integration.test.mjs",
    "test:package": "node --test test/package.integration.test.mjs",
    "test:all": "npm run test:core && npm run test:package && npm run test:browser && npm run test:desktop && npm run test:repair && npm run test:guided && npm run test:ipc && npm run test:ci-example",
    "demo": "node bin/core-demo.mjs",
    "demo:browser": "node bin/recovery-probe.mjs --demo --out artifacts/browser-demo.json",
    "prepublishOnly": "npm run test:core && npm run test:package && npm run test:ipc",
    "test:desktop": "node --test test/desktop.test.mjs",
    "test:desktop:electron": "node --test test/desktop.electron.test.mjs",
    "test:repair": "node --test test/repair.test.mjs test/repair.integration.test.mjs test/web.integration.test.mjs",
    "test:repair:electron": "node --test test/repair.electron.test.mjs",
    "test:guided": "node --test test/guided-start.test.mjs test/guided-start.integration.test.mjs",
    "test:ipc": "node --test test/ipc-probe.test.mjs test/ipc-control.test.mjs test/ipc-observation.test.mjs test/visibility.test.mjs test/refresh.test.mjs test/observe.test.mjs test/observation-report.test.mjs test/report-template.test.mjs test/observe-features.test.mjs",
    "test:ipc:electron": "node --test --test-concurrency=1 test/ipc.electron.test.mjs test/observe.electron.test.mjs test/observe-queue.electron.test.mjs",
    "benchmark:observe": "node scripts/benchmark-observe.mjs",
    "test:ci-example": "node examples/ci/verify.mjs"
  }
}
