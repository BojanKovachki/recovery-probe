{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.BojanKovachki/recovery-probe",
  "description": "Fail reads in web and Electron test apps, inspect recovery, and compare before/after evidence.",
  "repository": {
    "url": "https://github.com/BojanKovachki/recovery-probe",
    "source": "github"
  },
  "version": "1.0.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "recovery-probe",
      "version": "1.0.2",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
