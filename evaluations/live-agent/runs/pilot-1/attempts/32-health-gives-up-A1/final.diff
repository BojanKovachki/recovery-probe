@@ -13,9 +13,7 @@ export async function withRetry(
     try {
       return await read()
     } catch (error) {
-      // An overloaded server answers 503 again: more retries only add load.
-      const overloaded = error.status === 503 && attempt > 0
-      if (attempt >= delays.length || overloaded) throw error
