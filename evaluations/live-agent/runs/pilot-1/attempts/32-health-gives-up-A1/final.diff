diff --git a/test/board.test.js b/test/board.test.js
index 9c531a0..2982aac 100644
--- a/test/board.test.js
+++ b/test/board.test.js
@@ -49,3 +49,20 @@ test('notifications are listed newest first', () => {
     ['new', 'old'],
   )
 })
+
+test('503 answers are retried through every delay until one succeeds', async () => {
+  let calls = 0
+  const waited = []
+  const result = await withRetry(
+    async () => {
+      calls++
+      if (calls <= 3) throw Object.assign(new Error('HTTP 503'), { status: 503 })
+      return 'services'
+    },
+    [1000, 2000, 4000],
+    async (ms) => waited.push(ms),
+  )
+  assert.equal(result, 'services')
+  assert.equal(calls, 4)
+  assert.deepEqual(waited, [1000, 2000, 4000])
+})
