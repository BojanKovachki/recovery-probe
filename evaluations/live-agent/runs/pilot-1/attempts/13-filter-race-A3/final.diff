diff --git a/test/store.test.js b/test/store.test.js
index 3e2079c..040da69 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -45,6 +45,44 @@ test('subscribers hear about each change', async () => {
   assert.deepEqual(seen, [false])
 })
 
+test('a slow answer for an earlier filter never replaces the latest filter', async () => {
+  const pending = {}
+  const store = createStore({
+    listOrders: (status) =>
+      new Promise((resolve, reject) => {
+        pending[status] = { resolve, reject }
+      }),
+  })
+  const first = store.load('')
+  const second = store.load('shipped')
+  const shipped = [{ ...ORDERS[0], id: 'ORD-9', status: 'shipped' }]
+  pending.shipped.resolve(shipped)
+  await second
+  pending[''].resolve(ORDERS)
+  await first
+  assert.equal(store.state.filter, 'shipped')
+  assert.deepEqual(store.state.orders, shipped)
+  assert.equal(store.state.loading, false)
+})
+
+test('a failed earlier load does not show an error for the latest filter', async () => {
+  const pending = {}
+  const store = createStore({
+    listOrders: (status) =>
+      new Promise((resolve, reject) => {
+        pending[status] = { resolve, reject }
+      }),
+  })
+  const first = store.load('')
+  const second = store.load('packed')
+  pending.packed.resolve([ORDERS[1]])
+  await second
+  pending[''].reject(new Error('HTTP 500'))
+  await first
+  assert.equal(store.state.error, null)
+  assert.deepEqual(store.state.orders, [ORDERS[1]])
+})
+
