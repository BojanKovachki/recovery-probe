index 3e2079c..8a2f46f 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -45,6 +45,35 @@ test('subscribers hear about each change', async () => {
   assert.deepEqual(seen, [false])
 })
 
+test('shipping an order updates its row and tells subscribers', async () => {
+  const store = createStore({
+    listOrders: async () => ORDERS.map((order) => ({ ...order })),
+    updateStatus: async (id, status) => ({ ...ORDERS[1], id, status }),
+  })
+  await store.load('')
+  const before = store.state.orders
+  let notified = 0
+  store.subscribe(() => notified++)
+  await store.ship('ORD-2')
+  assert.equal(notified, 1)
+  assert.notEqual(store.state.orders, before)
+  assert.equal(store.state.orders[1].status, 'shipped')
+  assert.equal(store.state.orders[0].status, 'new')
+})
+
+test('a failed update keeps the status and shows the message', async () => {
+  const store = createStore({
+    listOrders: async () => ORDERS.map((order) => ({ ...order })),
+    updateStatus: async () => {
+      throw new Error('HTTP 500')
+    },
+  })
+  await store.load('')
+  await store.ship('ORD-2')
+  assert.equal(store.state.orders[1].status, 'packed')
+  assert.equal(store.state.error, 'Could not update the order.')
+})
+
