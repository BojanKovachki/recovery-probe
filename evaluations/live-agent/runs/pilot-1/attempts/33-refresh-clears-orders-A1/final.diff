+test('a failed refresh keeps the orders and the next success clears the message', async () => {
+  let fail = false
+  const store = createStore({
+    listOrders: async () => {
+      if (fail) throw new Error('offline')
+      return ORDERS
+    },
+  })
+  await store.load('')
+  fail = true
+  await store.refresh()
+  assert.equal(store.state.error, 'Could not refresh orders.')
+  assert.equal(store.state.orders.length, 2)
+  assert.equal(store.state.loading, false)
+  fail = false
+  await store.refresh()
+  assert.equal(store.state.error, null)
+  assert.equal(store.state.orders.length, 2)
+})
