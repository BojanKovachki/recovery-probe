+test('shipping a packed order updates its row once the server confirms', async () => {
+  const store = createStore({
+    listOrders: async () => ORDERS.map((order) => ({ ...order })),
+    updateStatus: async (id, status) => ({
+      ...ORDERS.find((order) => order.id === id),
+      status,
+      updatedAt: 'now',
+    }),
+  })
+  await store.load('')
+  const seen = []
+  store.subscribe((state) => seen.push(state.orders.map((o) => o.status)))
+  await store.ship('ORD-2')
+  assert.deepEqual(seen, [['new', 'shipped']])
+  assert.equal(store.state.orders[1].updatedAt, 'now')
+})
+
+test('a failed update keeps the row and shows the message', async () => {
+  const store = createStore({
+    listOrders: async () => ORDERS.map((order) => ({ ...order })),
+    updateStatus: async () => {
+      throw new Error('HTTP 500')
+    },
+  })
+  await store.load('')
+  await store.ship('ORD-2')
+  assert.equal(store.state.orders[1].status, 'packed')
+  assert.equal(store.state.error, 'Could not update the order.')
+})
+
