index 3e2079c..e969786 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -45,6 +45,47 @@ test('subscribers hear about each change', async () => {
   assert.deepEqual(seen, [false])
 })
 
+test('a slow answer for an earlier filter does not replace the latest one', async () => {
+  const pending = {}
+  const store = createStore({
+    listOrders: (status) =>
+      new Promise((resolve) => {
+        pending[status] = () =>
+          resolve(ORDERS.filter((order) => !status || order.status === status))
+      }),
+  })
+  const first = store.load('')
+  const second = store.load('packed')
+  pending.packed()
+  await second
+  pending['']()
+  await first
+  assert.equal(store.state.filter, 'packed')
+  assert.deepEqual(
+    store.state.orders.map((order) => order.id),
+    ['ORD-2'],
+  )
+  assert.equal(store.state.loading, false)
+})
+
+test('a stale failure does not show an error over the latest load', async () => {
+  const pending = {}
+  const store = createStore({
+    listOrders: (status) =>
+      new Promise((resolve, reject) => {
+        pending[status] = { resolve, reject }
+      }),
+  })
+  const first = store.load('')
+  const second = store.load('packed')
+  pending.packed.resolve([ORDERS[1]])
+  await second
+  pending[''].reject(new Error('HTTP 503'))
+  await first
+  assert.equal(store.state.error, null)
+  assert.equal(store.state.orders.length, 1)
+})
+
