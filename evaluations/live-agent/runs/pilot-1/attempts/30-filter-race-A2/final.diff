+test('a slow answer for an earlier filter does not replace the latest filter', async () => {
+  const pending = {}
+  const store = createStore({
+    listOrders: (status) =>
+      new Promise((resolve, reject) => {
+        pending[status] = { resolve, reject }
+      }),
+  })
+  const first = store.load('')
+  const second = store.load('shipped')
+  pending.shipped.resolve([
+    { id: 'ORD-3', customer: 'C', status: 'shipped', total: 5, updatedAt: '' },
+  ])
+  await second
+  pending[''].resolve(ORDERS)
+  await first
+  assert.equal(store.state.filter, 'shipped')
+  assert.deepEqual(
+    store.state.orders.map((order) => order.id),
+    ['ORD-3'],
+  )
+  assert.equal(store.state.loading, false)
+})
+
+test('a late failure of an earlier load is ignored', async () => {
+  const pending = []
+  const store = createStore({
+    listOrders: () => new Promise((resolve, reject) => pending.push({ resolve, reject })),
+  })
+  const first = store.load('')
+  const second = store.load('new')
+  pending[1].resolve([ORDERS[0]])
+  await second
+  pending[0].reject(new Error('HTTP 503'))
+  await first
+  assert.equal(store.state.error, null)
+  assert.deepEqual(store.state.orders.map((order) => order.id), ['ORD-1'])
+})
+
